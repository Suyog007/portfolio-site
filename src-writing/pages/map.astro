---
import Layout from '../layouts/Layout.astro';
import MetroMap from '../components/MetroMap.astro';
import { getPosts } from '../../src/lib/posts';
import { buildMetro } from '../lib/metro';

const posts = await getPosts();
const map = buildMetro(posts);
---

<Layout title="Map" description="Every essay by Suyog Adhikari on a metro map: topics are lines, essays are stations.">
  <p class="sw-intro">Notes on building software, Web3, cryptography and whatever I'm deep in at the time.</p>
  {
    posts.length === 0 ? (
      <p class="sw-intro">Nothing published yet. The first essay is on its way.</p>
    ) : (
      <MetroMap map={map} />
    )
  }
  <p class="sw-elsewhere">Browse another way: <a href="/">the shelf</a>.</p>
</Layout>
