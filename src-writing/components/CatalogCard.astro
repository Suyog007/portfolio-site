---
import type { Station } from '../lib/metro';
import { stampDate, wordCount } from '../lib/format';

export interface Props {
  station: Station;
  number: number;
  seeAlso: Station[];
}

const { station, number, seeAlso } = Astro.props;
const { post, main } = station;
const date = post.data.date;
const sentence = (text: string) => (/[.!?]$/.test(text) ? text : `${text}.`);
const call = `${main.letter} ${date.getUTCFullYear()}.${String(date.getUTCMonth() + 1).padStart(2, '0')}`;
---

<a class="sw-card" href={station.url}>
  <div class="sw-card__head"><span>{call}</span><span>No. {String(number).padStart(3, '0')}</span></div>
  <p class="sw-card__line sw-card__title">{sentence(station.title)}</p>
  <p class="sw-card__line">Adhikari, Suyog.</p>
  <p class="sw-card__line sw-card__muted">{wordCount(post.body).toLocaleString('en-US')} words · {station.minutes} min read</p>
  {seeAlso.length > 0 && <p class="sw-card__line sw-card__muted">See also: {seeAlso.map((s) => s.title).join('; ')}.</p>}
  <span class="sw-stamp">{post.data.updated ? 'Revised' : 'Shelved'} {stampDate(post.data.updated ?? date)}</span>
</a>
