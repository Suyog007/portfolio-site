---
import { Font } from 'astro:assets';
import { SITE, LINKS, MAIN_URL } from '../../src/site.config';
import { cleanPath } from '../../src/lib/url';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/tokens.css';
import '../styles/bundle.css';
import '../styles/writing.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: { published: Date; modified?: Date; tags: string[] };
  noindex?: boolean;
}

const BRAND = "Suyog's Writing";
const DESCRIPTION = "Notes on building software, Web3, cryptography and whatever I'm deep in at the time.";
const { title, description = DESCRIPTION, image = '/og/default.png', article, noindex = false } = Astro.props;

const fullTitle = title ? `${title} · ${BRAND}` : BRAND;
const path = cleanPath(Astro.url.pathname);
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: MAIN_URL,
  jobTitle: SITE.role,
  sameAs: [LINKS.github, LINKS.linkedin],
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#dfe4d7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1e19" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${BRAND}`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={title ?? BRAND} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
          <meta property="article:author" content={SITE.name} />
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    {!article && path === '/' && <script type="application/ld+json" set:html={JSON.stringify(person)} />}

    <Font cssVariable="--font-sw-display" preload />
    <Font cssVariable="--font-sw-serif" preload />
    <Font cssVariable="--font-sw-hand" />
    <Font cssVariable="--font-sw-mono" />

    <!-- Resolve the theme before first paint so there is no flash. -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="sw-site-head">
      <a class="sw-brand" href="/" aria-current={path === '/' ? 'page' : undefined}>{BRAND}</a>
      <nav class="sw-site-nav" aria-label="Browse">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Map</a>
        <a href="/shelf" aria-current={path === '/shelf' ? 'page' : undefined}>Shelf</a>
        <a href="/writing" aria-current={path === '/writing' || path.startsWith('/writing/tags') ? 'page' : undefined}>Archive</a>
        <ThemeToggle />
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="sw-site-foot">
      <a href={MAIN_URL}>← suyogadhikari.tech</a>
      <a href="/rss.xml">RSS</a>
      <span>© {new Date().getFullYear()} {SITE.name}</span>
    </footer>
  </body>
</html>
