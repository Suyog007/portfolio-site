---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page doesn't exist." noindex>
  <header class="page-head">
    <p class="code">404</p>
    <h1>Nothing here.</h1>
    <p>The page you were looking for has moved or never existed. Even the robot looked.</p>
  </header>
  <p class="links">
    <a href="/">Home</a>
    <a href="/writing">Writing</a>
    <a href="/projects">Projects</a>
  </p>
</Base>

<style>
  .code {
    margin-bottom: var(--space-2);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .links {
    display: flex;
    gap: var(--space-5);
  }
</style>
