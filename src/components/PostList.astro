---
import type { Post } from '../lib/posts';

export interface Props {
  posts: Post[];
  /** Show the year in the date column (off when the list is already grouped by year). */
  withYear?: boolean;
}

const { posts, withYear = true } = Astro.props;

const format = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    ...(withYear ? { year: 'numeric' } : {}),
    timeZone: 'UTC',
  });
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>{format(post.data.date)}</time>
        <div>
          <a href={`/writing/${post.id}`}>
            {post.data.title}
            {post.data.draft && <span class="draft">Draft</span>}
          </a>
          <p>{post.data.description}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }

  li:last-child {
    border-bottom: 1px solid var(--line);
  }

  time {
    padding-top: 0.15rem;
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  a {
    font-weight: 500;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  p {
    margin-top: var(--space-1);
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .draft {
    margin-left: var(--space-2);
    padding: 0.05rem 0.4rem;
    border: 1px dashed var(--accent);
    border-radius: 4px;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 500;
    vertical-align: 0.1em;
  }

  @media (max-width: 539px) {
    li {
      grid-template-columns: 1fr;
    }
    time {
      order: 2;
      padding-top: 0;
    }
  }
</style>
