---
export interface Props {
  tags: { name: string; slug: string; count: number }[];
  total: number;
  current?: string;
}

const { tags, total, current } = Astro.props;
---

{
  tags.length > 0 && (
    <nav class="tags" aria-label="Filter by tag">
      <a href="/writing" aria-current={!current ? 'page' : undefined}>
        All <span>{total}</span>
      </a>
      {tags.map((tag) => (
        <a href={`/writing/tags/${tag.slug}`} aria-current={current === tag.slug ? 'page' : undefined}>
          {tag.name} <span>{tag.count}</span>
        </a>
      ))}
    </nav>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-7);
  }

  a {
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
  }

  a:hover {
    color: var(--ink);
    border-color: var(--muted);
  }

  a[aria-current='page'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  span {
    margin-left: 0.2rem;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }
</style>
