---
import { render, type CollectionEntry } from 'astro:content';

export interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, area, stack, github, demo, featured } = project.data;
const { Content } = await render(project);
const hasBody = (project.body ?? '').trim().length > 0;
const tags = stack.length > 0 ? stack : area;
---

<article class="card" id={project.id} data-areas={area.join('|')}>
  <div class="badges">
    {demo && <span class="badge live">Live</span>}
    {featured && <span class="badge feat">Featured</span>}
  </div>
  <h2 class="title">{title}</h2>
  <p class="summary">{summary}</p>
  {
    hasBody && (
      <details>
        <summary>Show details</summary>
        <div class="body">
          <Content />
        </div>
      </details>
    )
  }
  <div class="foot">
    <ul class="tags">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
    <p class="links">
      {
        demo && (
          <a href={demo} aria-label={`Live demo of ${title}`} title="Live demo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18" /></svg>
          </a>
        )
      }
      {
        github && (
          <a href={github} aria-label={`Code for ${title}`} title="Code on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" /></svg>
          </a>
        )
      }
    </p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    transition: border-color 0.15s, transform 0.15s;
  }

  .card:hover {
    border-color: var(--muted);
    transform: translateY(-2px);
  }

  .badges {
    display: flex;
    gap: var(--space-2);
    min-height: 1.4rem;
  }

  .badge {
    padding: 0.1rem 0.5rem;
    border-radius: 6px;
    border: 1px solid;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .live {
    color: #1f8f5f;
    border-color: color-mix(in srgb, #1f8f5f 45%, transparent);
  }

  .feat {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .title {
    margin-top: var(--space-3);
    font-family: var(--sans);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0;
  }

  .summary {
    margin-top: var(--space-2);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  details {
    margin-top: var(--space-3);
    font-size: 0.9375rem;
  }

  summary {
    width: fit-content;
    cursor: pointer;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  summary:hover {
    color: var(--ink);
  }

  .body {
    margin-top: var(--space-2);
    color: var(--ink-2);
  }

  .foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper-2);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-3);
  }

  .links a {
    color: var(--muted);
    line-height: 0;
  }

  .links a:hover {
    color: var(--ink);
  }

  svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }
</style>
