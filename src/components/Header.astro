---
import { HOME_URL, IS_WRITING_SITE, NAV, SITE, WRITING_URL } from '../site.config';
import Robot from './Robot.astro';
import ThemeToggle from './ThemeToggle.astro';
import { cleanPath } from '../lib/url';

const path = cleanPath(Astro.url.pathname);
const onWriting = path === '/writing' || path.startsWith('/writing/') || (IS_WRITING_SITE && path === '/');
const isCurrent = (href: string) => {
  if (href === WRITING_URL || href === '/writing') return onWriting;
  if (href.startsWith('http')) return false;
  return path === href || path.startsWith(`${href}/`);
};
---

<header class="container header">
  <div class="brand">
    <Robot />
    <a class="name" href={HOME_URL} aria-current={!IS_WRITING_SITE && path === '/' ? 'page' : undefined}>{SITE.name}</a>
  </div>
  <nav aria-label="Main">
    <ul>
      {
        NAV.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <ThemeToggle />
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    flex-wrap: wrap;
    padding-top: var(--space-6);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .name {
    font-family: var(--serif);
    font-size: 1.375rem;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  ul {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
  }

  @media (max-width: 539px) {
    nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
